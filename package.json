{
  "name": "whisper-tauri",
  "version": "0.1.0",
  "description": "Local audio transcription desktop application",
  "private": true,
  "type": "module",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "check": "biome check src/ && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fix": "biome check --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:reset": "bash scripts/dev-reset.sh",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.3",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.19",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@kobalte/tailwindcss": "^0.9.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.0"
  }
}
