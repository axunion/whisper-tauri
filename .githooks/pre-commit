#!/usr/bin/env bash
# pre-commit: auto-format staged files so the commit always reflects formatted code.
# - TypeScript/TSX under src/   -> biome check --write
# - Rust under src-tauri/       -> cargo fmt (on the changed files)
# Re-stages any modifications so the commit picks them up.
# Written for bash 3.2 compatibility (macOS default).

set -euo pipefail

# Skip during merge/rebase: rewriting files mid-conflict can mangle markers.
git_dir=$(git rev-parse --git-dir)
if [[ -e "$git_dir/MERGE_HEAD" || -e "$git_dir/REBASE_HEAD" \
   || -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
  exit 0
fi

ts_files=()
rs_files=()
while IFS= read -r -d '' f; do
  case "$f" in
    src/*)
      if [[ "$f" == *.ts || "$f" == *.tsx ]]; then
        ts_files+=("$f")
      fi
      ;;
    src-tauri/*)
      if [[ "$f" == *.rs ]]; then
        rs_files+=("$f")
      fi
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Refuse when a staged file also has unstaged edits: auto-fmt + `git add`
# would otherwise silently sweep the unstaged hunks into the commit.
check_partial_stage() {
  local files=("$@")
  [[ ${#files[@]} -gt 0 ]] || return 0
  if ! git diff --quiet -- "${files[@]}"; then
    echo "pre-commit: staged file has unstaged edits; commit fully-staged files or stash first." >&2
    git diff --name-only -- "${files[@]}" >&2
    exit 1
  fi
}

# Length-guard on the array expansion is mandatory: bash 3.2 treats
# "${arr[@]}" as unset under `set -u` when the array is empty.
if [[ ${#ts_files[@]} -gt 0 ]]; then
  command -v pnpm >/dev/null || { echo "pre-commit: pnpm not in PATH (GUI client?)" >&2; exit 1; }
  check_partial_stage "${ts_files[@]}"
  pnpm exec biome check --write --no-errors-on-unmatched "${ts_files[@]}"
  git add -- "${ts_files[@]}"
fi

if [[ ${#rs_files[@]} -gt 0 ]]; then
  command -v cargo >/dev/null || { echo "pre-commit: cargo not in PATH" >&2; exit 1; }
  check_partial_stage "${rs_files[@]}"
  # cargo fmt takes paths relative to the manifest; strip the src-tauri/ prefix.
  rel=()
  for f in "${rs_files[@]}"; do
    rel+=("${f#src-tauri/}")
  done
  ( cd src-tauri && cargo fmt -- "${rel[@]}" )
  git add -- "${rs_files[@]}"
fi
